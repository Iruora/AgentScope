{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentScope",
  "version": "1.4.0",
  "identifier": "io.github.iruora.agentscope",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentScope",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Every agent. Every action. One view.",
    "longDescription": "See every local AI coding agent, its subagents, what it is doing, and which ones are waiting for your approval.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/agentscope-hook"
    ],
    "license": "MIT OR Apache-2.0",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMkYwRUVCNTU2QUMyODMKUldTRHdtcFY2dzR2di9tQkJzTy9iN3JZaExrT3VNbmpKWVkzTFcxaStCN05kUjFHTTNYbm1xK0MK",
      "endpoints": [
        "https://github.com/Iruora/AgentScope/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
